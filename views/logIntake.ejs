<!-- Log Intake -->
<!DOCTYPE html>
<html>
    <head>
        <title>Log Intake</title>
        <link rel="stylesheet" href="/index.css">
        <link rel="fav icon" type="image/x-icon" href="/image/pill.png">
    </head>
    <body>
        <h1>Log Intake</h1>
        <!-- Log intake form -->
        <form class="log-intake" id="log-intake-form">
            <!-- Provider Information -->
             <div class="form">
                <label for="medication-select" style="font-size: 18px;">Medication</label>
                <select name="medications" id="medication-select" required>
                    <option value="">--Select an option--</option>
                    <% medications.forEach(medication => { %>
                        <option value="<%= medication.prescription_id%>"><%= medication.prescription_name %></option>
                    <% }); %>
                </select>
                <div>
                    <input type="radio" value="taken" name="status" id="radio-taken" required> 
                    <label for="radio-taken" class="option" >Taken</label>
                </div>
                <div>
                    <input type="radio" value="missed" name="status" id="radio-missed"> 
                    <label class="option">Missed</label>
                </div>
                <input type="text" id="report-date" placeholder="Date" onfocus="(this.type='date')">
                <input type="text" id="intake-time" placeholder="Time Taken" onfocus="(this.type='time')" style="display: none">
                <textarea class="auto-expand" id="additional-notes" type='text' placeholder="Additional Notes"></textarea>
            </div> 
            <!-- Error message displayed on reload if add provider failed -->
            <span class="provider-error-spacing" id="correctMessage" style="display: none"></span>
            <button type="submit" id="log-btn">Submit</button>
            <br>
            <button onclick="window.location.href='<%= patientPortal %>'">Return to Portal</button>
        </form>
        </div>
        <script src="/logIntake.js"></script>
    </body>
</html>

