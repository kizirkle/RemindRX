<!-- Patient portal -->
<!DOCTYPE html>
<html>
    <head>
        <title>Patient Profile</title>
        <link rel="stylesheet" href="/index.css">
        <link rel="fav icon" type="image/x-icon" href="/image/pill.png">
    </head>
    <body>
        <h1 id="patient-name">Provider Profile</h1>
        <div id="centered">
            <div id="profile-info">
                <p><b>Name</b>: <%= providerName %></p>
                <p><b>Provider ID</b>: <%= providerId %></p>
                <p><b>Email</b>: <%= providerEmail %></p>
                <p><b>Phone number</b>: <%= providerPhoneNumber %></p>
                <h2 id="patient-name">Patients</h2>
                    <div id="names-profile">
                        <% patients.forEach(patient => { %>
                            <li><%= patient %></li>
                        <% }) %>
                        </div>
                <button onclick="window.location.href='<%= providerPortal %>'">Return to Portal</button>
                <button onclick="logout()">Log Out</button>
            </div>
        </div>
        <script src="/logout.js"></script>
    </body>
</html>