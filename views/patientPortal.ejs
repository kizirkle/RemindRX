<!-- Patient portal -->
<!DOCTYPE html>
<html>
    <head>
        <title>Patient Portal</title>
        <link rel="stylesheet" href="../index.css">
        <link rel="fav icon" type="image/x-icon" href="../image/pill.png">
    </head>
    <body>
        <h1 id="patient-name">Welcome, <%= patientName %></h1>
        <h2 id="patient-name">Healthcare Providers</h2>
            <div id="provider-names">
                <% providers.forEach(provider => { %>
                    <span><%= provider %></span><br>
                <% }) %>
            </div>
        
        <button id="add-medication-btn" onclick="window.location.href='<%= providerPortal %>'">Add Healthcare Provider</button>
    </body>
</html>