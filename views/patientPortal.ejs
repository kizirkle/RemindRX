<!-- Patient portal -->
<!DOCTYPE html>
<html>
    <head>
        <title>Patient Portal</title>
        <link rel="stylesheet" href="/index.css">
        <link rel="fav icon" type="image/x-icon" href="/image/pill.png">
    </head>
    <body>
        <h1 id="patient-name">Welcome, <%= patientName %></h1>
        <button id="add-medication-btn" onclick="window.location.href='<%= addProvider %>'">Add Healthcare Provider</button>
        <br>
        <button id="medications-btn" onclick="window.location.href='<%= medications %>'">Medications</button>
        <br>
        <button id="log-intake-btn" onclick="window.location.href='<%= logIntake %>'">Log Intake</button>
        <br>
        <button id="add-medication-btn" onclick="window.location.href='<%= patientProfile %>'">View Profile</button>
        <br>
        <button onclick="logout()">Log Out</button>
        <br>
        <script src="/logout.js"></script>
    </body>
</html>