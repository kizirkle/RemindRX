<!-- View medications -->
<!DOCTYPE html>
<html>
    <head>
        <title>Medications</title>
        <link rel="stylesheet" href="/index.css">
        <link rel="fav icon" type="image/x-icon" href="/image/pill.png">
    </head>
    <div id="logo-container">
        <img src="/image/remindrx_logo.svg" alt="RemindRx Logo" id="brand-logo" style="width: 275px;">
    </div>
    <body>
        <h1>Medications</h1>
        <h2 id="current-medications" style="font-size: 25px; padding-top: 10px;"><u>Current Medications</u></h2>
        <br>
        <div id="table-format">
            <!-- Creates a past medications table -->
            <% var counter = 0; %>
            <% currentMedications.forEach(currentMedication => { %>
                <!-- Loop through the current medications array and add rows -->
                <% if(counter === 0) {%>
                    <table>
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Healthcare Provider</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Total Pills</th>
                                <th>Dose</th>
                                <th>Frequency</th>
                                <th>Side Effects</th>
                                <th>Additional Notes</th>
                            </tr>
                        </thead>
                        <% counter = 1 %>
                <% } %>
                <tbody>
                <tr>
                    <td><%= currentMedication.prescription_name %></td>
                    <td><%= currentMedication.provider_first_name %> <%= currentMedication.provider_last_name %></td>
                    <td><%= currentMedication.start_date %></td>
                    <td><%= currentMedication.end_date %></td>
                    <td><%= currentMedication.total_pills %></td>
                    <td><%= currentMedication.dose %></td>
                    <td>Every <%= currentMedication.frequency_hours %> <%= currentMedication.frequency_hours === 1 ? 'hour' : 'hours' %></td>
                    <td><%= currentMedication.side_effects %></td>
                    <td><%= currentMedication.additional_notes %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <br>
        <h2 id="past-medications" style="font-size: 25px;"><u>Past Medications</u></h2>
        <br>
        <div id="table-format">
            <!-- Creates a past medications table -->
            <% var counter = 0; %>
            <% pastMedications.forEach(pastMedication => { %>
                <!-- Loop through the past medications array and add rows -->
                <% if(counter === 0) {%>
                    <table>
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Healthcare Provider</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Total Pills</th>
                                <th>Dose</th>
                                <th>Frequency</th>
                                <th>Side Effects</th>
                                <th>Additional Notes</th>
                            </tr>
                        </thead>
                        <% counter = 1 %>
                <% } %>
                <tbody>
                <tr>
                    <td><%= pastMedication.prescription_name %></td>
                    <td><%= pastMedication.provider_first_name %> <%= pastMedication.provider_last_name %></td>
                    <td><%= pastMedication.start_date %></td>
                    <td><%= pastMedication.end_date %></td>
                    <td><%= pastMedication.total_pills %></td>
                    <td><%= pastMedication.dose %></td>
                    <td>Every <%= pastMedication.frequency_hours %> <%= pastMedication.frequency_hours === 1 ? 'hour' : 'hours' %></td>
                    <td><%= pastMedication.side_effects %></td>
                    <td><%= pastMedication.additional_notes %></td>
                </tr>
            <% }); %>
        </tbody>
        </table>
        </div>
        <br>
        <h2 id="future-medications" style="font-size: 25px;"><u>Future Medications</u></h2>
        <br>
        <div id="table-format">
            <!-- Creates a future medications table -->
            <% var counter = 0; %>
            <% futureMedications.forEach(futureMedication => { %>
                <!-- Loop through the future medications array and add rows -->
                <% if(counter === 0) {%>
                    <table>
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Healthcare Provider</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Total Pills</th>
                                <th>Dose</th>
                                <th>Frequency</th>
                                <th>Side Effects</th>
                                <th>Additional Notes</th>
                            </tr>
                        </thead>
                        <% counter = 1 %>
                <% } %>
                <tbody>
                <tr>
                    <td><%= futureMedication.prescription_name %></td>
                    <td><%= futureMedication.provider_first_name %> <%= futureMedication.provider_last_name %></td>
                    <td><%= futureMedication.start_date %></td>
                    <td><%= futureMedication.end_date %></td>
                    <td><%= futureMedication.total_pills %></td>
                    <td><%= futureMedication.dose %></td>
                    <td>Every <%= futureMedication.frequency_hours %> <%= futureMedication.frequency_hours === 1 ? 'hour' : 'hours' %></td>
                    <td><%= futureMedication.side_effects %></td>
                    <td><%= futureMedication.additional_notes %></td>
                </tr>
            <% }); %>
        </tbody>
        </table>
        </div>
        <button id="return-home-btn" style="margin: 20px 0px" window.location.href='<%= patientPortal %>'">Return to Portal</button>
        <br>
        <script src="/logout.js"></script>
    </body>
</html>