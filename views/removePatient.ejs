<!-- Delete Provider Account -->
<!DOCTYPE html>
<html>
    <head>
        <title>Remove Patient</title>
        <link rel="stylesheet" href="/index.css">
        <link rel="fav icon" type="image/x-icon" href="/image/pill.png">
    </head>
    <div id="logo-container">
        <img src="/image/remindrx_logo.svg" alt="RemindRx Logo" id="brand-logo" style="width: 275px;">
    </div>
    <body>
        <h1>Remove <B>Patient</B></h1>
        <form class="log-intake" id="remove-patient-form">
             <div class="form">
                <label style="font-size: 18px;">Patient</label>
                <select name="patient" id="provider-select" required>
                    <option value="">--Select an option--</option>
                    <% patients.forEach(patient => { %>
                        <option value="<%= patient.patient_id%>"> <%= patient.patient_first_name%> <%= patient.patient_last_name%></option>
                    <% }); %>
                </select>
                <button type="submit" id="remove-provider-btn">Remove</button>
            <div>
        </form>
        <button onclick="window.location.href='<%= providerProfile %>'">Return to Profile</button>
        <script src="/removePatient.js"></script>
    </body>

</html>